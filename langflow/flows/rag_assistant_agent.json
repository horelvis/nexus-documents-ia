{
  "name": "RAG Assistant Agent",
  "description": "Retrieval-Augmented Generation assistant for intelligent document search and contextual Q&A",
  "data": {
    "nodes": [
      {
        "id": "user_question",
        "type": "input",
        "position": { "x": 100, "y": 200 },
        "data": {
          "label": "User Question",
          "type": "text",
          "description": "Natural language question about documents"
        }
      },
      {
        "id": "search_context",
        "type": "input",
        "position": { "x": 100, "y": 350 },
        "data": {
          "label": "Search Context",
          "type": "search_results",
          "description": "Previous search results to use as context"
        }
      },
      {
        "id": "query_embedder",
        "type": "embeddings",
        "position": { "x": 300, "y": 200 },
        "data": {
          "label": "Query Embedder",
          "model": "text-embedding-ada-002",
          "dimension": 1536
        }
      },
      {
        "id": "vector_search",
        "type": "qdrant_search",
        "position": { "x": 500, "y": 200 },
        "data": {
          "label": "Vector Document Search",
          "collection": "documents",
          "top_k": 10,
          "score_threshold": 0.7
        }
      },
      {
        "id": "context_builder",
        "type": "custom_component",
        "position": { "x": 700, "y": 250 },
        "data": {
          "label": "Context Builder",
          "function": "build_rag_context",
          "max_tokens": 3000,
          "chunk_overlap": 100
        }
      },
      {
        "id": "suggestion_generator",
        "type": "llm",
        "position": { "x": 500, "y": 400 },
        "data": {
          "label": "Suggestion Generator",
          "model": "gpt-3.5-turbo",
          "temperature": 0.7,
          "system_prompt": "Generate relevant follow-up questions based on the context and user's current question."
        }
      },
      {
        "id": "rag_llm",
        "type": "llm",
        "position": { "x": 900, "y": 250 },
        "data": {
          "label": "RAG Response LLM",
          "model": "gpt-4",
          "temperature": 0.5,
          "system_prompt": "You are a helpful AI assistant analyzing documents. Use the provided context to answer questions accurately. If information is not in the context, say so clearly. Always cite which documents you're referencing."
        }
      },
      {
        "id": "thinking_display",
        "type": "streaming_component",
        "position": { "x": 900, "y": 100 },
        "data": {
          "label": "Thinking Process Display",
          "show_reasoning": true,
          "show_document_refs": true
        }
      },
      {
        "id": "response_validator",
        "type": "custom_component",
        "position": { "x": 1100, "y": 250 },
        "data": {
          "label": "Response Validator",
          "function": "validate_rag_response",
          "checks": [
            "citation_accuracy",
            "relevance_score",
            "hallucination_detection"
          ]
        }
      },
      {
        "id": "chat_memory",
        "type": "memory",
        "position": { "x": 700, "y": 100 },
        "data": {
          "label": "Conversation Memory",
          "type": "sliding_window",
          "window_size": 10,
          "store_embeddings": true
        }
      },
      {
        "id": "response_formatter",
        "type": "template",
        "position": { "x": 1300, "y": 250 },
        "data": {
          "label": "Response Formatter",
          "template": "### Answer:\n{answer}\n\n### Sources:\n{sources}\n\n### Confidence: {confidence}\n\n### Suggested Questions:\n{suggestions}"
        }
      },
      {
        "id": "output_stream",
        "type": "output",
        "position": { "x": 1500, "y": 250 },
        "data": {
          "label": "Streaming Response Output",
          "format": "markdown",
          "streaming": true
        }
      }
    ],
