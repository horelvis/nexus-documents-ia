      },
      {
        "id": "e8",
        "source": "expense_analyzer",
        "target": "insight_generator",
        "type": "default"
      },
      {
        "id": "e9",
        "source": "cash_flow_analyzer",
        "target": "insight_generator",
        "type": "default"
      },
      {
        "id": "e10",
        "source": "insight_generator",
        "target": "response_formatter",
        "type": "default"
      }
