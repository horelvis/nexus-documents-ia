  "config": {
    "features": [
      "Chain of Thought reasoning",
      "Multi-step financial analysis",
      "Real-time document processing",
      "Pattern recognition for expenses",
      "Due date tracking and alerts",
      "Cash flow forecasting"
    ],
    "tools": [
      "calculate",
      "search_documents",
      "analyze_document"
    ],
    "specialized_functions": [
      "extract_amounts",
