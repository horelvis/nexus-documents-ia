{
  "name": "Legal Compliance Agent",
  "description": "Contract analysis agent specializing in legal compliance, risk assessment, and regulatory adherence",
  "data": {
    "nodes": [
      {
        "id": "contract_input",
        "type": "input",
        "position": { "x": 100, "y": 200 },
        "data": {
          "label": "Contract/Legal Document",
          "type": "document",
          "description": "Legal document or contract to analyze"
        }
      },
      {
        "id": "analysis_request",
        "type": "input",
        "position": { "x": 100, "y": 350 },
        "data": {
          "label": "Analysis Request",
          "type": "text",
          "description": "Specific compliance or legal analysis request"
        }
      },
      {
        "id": "document_parser",
        "type": "custom_component",
        "position": { "x": 300, "y": 275 },
        "data": {
          "label": "Legal Document Parser",
          "function": "parse_legal_document",
          "extract": [
            "parties",
            "dates",
            "clauses",
            "terms",
            "obligations"
          ]
        }
      },
      {
        "id": "clause_extractor",
        "type": "custom_component",
        "position": { "x": 500, "y": 100 },
        "data": {
          "label": "Clause Extractor",
          "function": "extract_contract_clauses",
          "clause_types": [
            "payment",
            "termination",
            "liability",
            "confidentiality",
            "indemnification",
            "governing_law"
          ]
        }
      },
      {
        "id": "risk_analyzer",
        "type": "custom_component",
        "position": { "x": 500, "y": 250 },
        "data": {
          "label": "Risk Analysis Engine",
          "function": "analyze_legal_risks",
          "risk_categories": [
            "financial",
            "legal",
            "operational",
            "reputational"
          ],
          "severity_levels": ["critical", "high", "medium", "low"]
        }
      },
      {
        "id": "compliance_checker",
        "type": "custom_component",
        "position": { "x": 500, "y": 400 },
        "data": {
          "label": "Compliance Checker",
          "function": "check_regulatory_compliance",
          "regulations": [
            "GDPR",
            "SOX",
            "CCPA",
            "HIPAA",
            "PCI-DSS"
          ],
          "jurisdictions": ["US", "EU", "UK", "CA"]
        }
      },
      {
        "id": "renewal_tracker",
        "type": "custom_component",
        "position": { "x": 500, "y": 550 },
        "data": {
          "label": "Renewal & Date Tracker",
          "function": "track_contract_dates",
          "track": [
            "effective_date",
            "expiration_date",
            "renewal_dates",
            "notice_periods",
            "milestone_dates"
          ]
        }
      },
      {
        "id": "legal_llm",
        "type": "llm",
        "position": { "x": 700, "y": 325 },
        "data": {
          "label": "Legal Analysis LLM",
          "model": "gpt-4",
          "temperature": 0.2,
          "system_prompt": "You are an expert legal analyst specializing in contract law, compliance, and risk assessment. Provide detailed, accurate legal analysis while clearly distinguishing between legal advice and analytical observations."
        }
      },
      {
        "id": "template_comparator",
        "type": "custom_component",
        "position": { "x": 700, "y": 500 },
        "data": {
          "label": "Template Comparator",
          "function": "compare_to_template",
          "templates": [
            "standard_nda",
            "service_agreement",
            "employment_contract",
            "license_agreement"
          ]
        }
      },
      {
        "id": "recommendation_engine",
        "type": "custom_component",
        "position": { "x": 900, "y": 325 },
        "data": {
          "label": "Legal Recommendation Engine",
          "function": "generate_legal_recommendations",
          "categories": [
            "must_fix",
            "should_negotiate",
            "nice_to_have",
            "acceptable"
          ]
        }
      },
      {
        "id": "report_generator",
        "type": "template",
        "position": { "x": 1100, "y": 325 },
        "data": {
          "label": "Compliance Report Generator",
          "template": "## Legal Compliance Analysis Report\n\n### Executive Summary\n{executive_summary}\n\n### Risk Assessment\n- Overall Risk Level: {risk_level}\n- Critical Issues: {critical_issues}\n\n### Compliance Status\n{compliance_results}\n\n### Key Clauses Analysis\n{clause_analysis}\n\n### Recommendations\n{recommendations}\n\n### Important Dates\n{key_dates}\n\n### Next Steps\n{next_steps}"
        }
      },
      {
        "id": "output_formatter",
        "type": "output",
        "position": { "x": 1300, "y": 325 },
        "data": {
          "label": "Formatted Legal Report",
          "format": "pdf",
          "include_annotations": true
        }
      }
