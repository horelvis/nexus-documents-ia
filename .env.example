# Domain Configuration
DOMAIN=nexusdocs360.com
APP_SUBDOMAIN=app
API_SUBDOMAIN=api
WWW_SUBDOMAIN=www

# Full URLs (generated from above)
FRONTEND_URL=https://${APP_SUBDOMAIN}.${DOMAIN}
API_URL=https://${API_SUBDOMAIN}.${DOMAIN}

# SSL Configuration
SSL_EMAIL=admin@${DOMAIN}
SSL_STAGING=false

# GCP Configuration
GCP_PROJECT_ID=nexusdocs360-prod
GCP_REGION=europe-west1
GCP_ZONE=europe-west1-b

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----XXXXXXXXXXX-----END PUBLIC KEY-----
CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Database
DATABASE_URL=postgresql://nexus_user:password@localhost:5432/nexus_db
ASYNC_DATABASE_URL=postgresql+asyncpg://nexus_user:password@localhost:5432/nexus_db

# Redis
REDIS_URL=redis://localhost:6379

# Stripe
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Email configuration handled by Google Workspace
# No additional email service needed

# Google Cloud Storage
GCS_PROJECT_ID=nexusdocs360-ia
GCS_BUCKET_NAME=nexusdocs360-eu
GCS_CREDENTIALS_PATH=/app/credentials/nexusdocs360-ia-credentials.json

# Microservices
MICROSERVICES_API_KEY=your-secure-api-key-here

# Security
SECRET_KEY=your-secret-key-here
SIGNATURE_ENCRYPTION_KEY=your-fernet-key-here

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO