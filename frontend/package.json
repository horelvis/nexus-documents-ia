{
  "name": "nouxcubeia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:on-premise": "turbo dev --filter=@nexus/on-premise",
    "dev:saas": "turbo dev --filter=@nexus/saas",
    "build": "turbo build",
    "build:on-premise": "turbo build --filter=@nexus/on-premise",
    "build:saas": "turbo build --filter=@nexus/saas",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.4",
      "react-dom": "19.1.4"
    }
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tabler/icons-react": "^3.38.0"
  }
}
