# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Backend API
# Option A (recommended): use Next.js rewrite proxy (/api/*) by setting the server-side base URL.
# The browser will call same-origin `/api/...`, and Next will forward to `${API_BASE_URL}/api/...`.
API_BASE_URL=http://localhost:8000

# Option B: call the backend directly from the browser (may require CORS).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# App Configuration
NEXT_PUBLIC_APP_NAME="Nexus Document Backend"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HTTPS Configuration (when using dev:https)
# NEXT_PUBLIC_APP_URL=https://localhost:3000

# Gemini API - Managed by backend (ephemeral tokens)
# API key is stored in backend .env as GEMINI_API_KEY
# Frontend obtains ephemeral tokens via /api/v1/gemini/voice-session
