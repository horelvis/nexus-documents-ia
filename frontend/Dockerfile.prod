# Frontend Dockerfile for production deployment (Next.js 15 standalone, single-app layout)
#
# Build context: frontend/
# Usage:
#   docker build -f Dockerfile.prod -t nouxcube-frontend .
# Or via compose:
#   docker compose --profile prod build frontend

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat

# ── Stage 1: Install dependencies ────────────────────────────────────
FROM base AS deps
WORKDIR /app

# Copy lockfiles + manifest first to maximize layer cache
COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps

# ── Stage 2: Build ───────────────────────────────────────────────────
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build args (NEXT_PUBLIC_* are baked into the client bundle at build time)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_API_STREAMING_URL
ARG NEXT_PUBLIC_WEAVIATE_SERVICE_URL
ARG NEXT_PUBLIC_EMMA_SERVICE_URL
ARG NEXT_PUBLIC_SSO_AUTHORITY
ARG NEXT_PUBLIC_SSO_CLIENT_ID
ARG NEXT_PUBLIC_SSO_REDIRECT_URI
ARG NEXT_PUBLIC_SSO_POST_LOGOUT_REDIRECT_URI
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_LANGFUSE_URL

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_API_STREAMING_URL=${NEXT_PUBLIC_API_STREAMING_URL}
ENV NEXT_PUBLIC_WEAVIATE_SERVICE_URL=${NEXT_PUBLIC_WEAVIATE_SERVICE_URL}
ENV NEXT_PUBLIC_EMMA_SERVICE_URL=${NEXT_PUBLIC_EMMA_SERVICE_URL}
ENV NEXT_PUBLIC_SSO_AUTHORITY=${NEXT_PUBLIC_SSO_AUTHORITY}
ENV NEXT_PUBLIC_SSO_CLIENT_ID=${NEXT_PUBLIC_SSO_CLIENT_ID}
ENV NEXT_PUBLIC_SSO_REDIRECT_URI=${NEXT_PUBLIC_SSO_REDIRECT_URI}
ENV NEXT_PUBLIC_SSO_POST_LOGOUT_REDIRECT_URI=${NEXT_PUBLIC_SSO_POST_LOGOUT_REDIRECT_URI}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_BACKEND_URL=${NEXT_PUBLIC_BACKEND_URL}
ENV NEXT_PUBLIC_LANGFUSE_URL=${NEXT_PUBLIC_LANGFUSE_URL}

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Avoid OOM during Next.js build
ENV NODE_OPTIONS="--max-old-space-size=4096"

RUN npm run build

# ── Stage 3: Runtime ─────────────────────────────────────────────────
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone server output (single React, traced node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:3000/ || exit 1

# server.js is generated by `next build` from the standalone output
CMD ["node", "server.js"]
