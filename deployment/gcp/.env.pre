# Pre-Production Environment Configuration
# This environment mirrors production with reduced resources for testing

# Domain Configuration (PRE subdomain)
DOMAIN=nouxcube.app
APP_SUBDOMAIN=pre
API_SUBDOMAIN=pre-api
WWW_SUBDOMAIN=pre-www

# SSL Configuration
SSL_EMAIL=devops@nouxcube.app
SSL_STAGING=false  # Use real certificates for PRE

# GCP Configuration - PRE Environment
GCP_PROJECT_ID=nouxcube-pre
GCP_REGION=europe-west1
GCP_ZONE=europe-west1-b

# Environment Identifier
ENVIRONMENT=pre
ENV_COLOR=yellow  # For easy visual identification

# Resource Scaling (50% of production)
MIN_INSTANCES=1
MAX_INSTANCES=2
CPU_LIMIT=0.5
MEMORY_LIMIT=1Gi

# Service URLs (auto-generated)
FRONTEND_URL=https://${APP_SUBDOMAIN}.${DOMAIN}
API_URL=https://${API_SUBDOMAIN}.${DOMAIN}
MAIN_URL=https://pre.${DOMAIN}
WWW_URL=https://${WWW_SUBDOMAIN}.${DOMAIN}

# Database Configuration (smaller instances)
DB_INSTANCE_TIER=db-f1-micro
REDIS_TIER=BASIC
REDIS_MEMORY_GB=1

# Feature Flags for PRE
ENABLE_AI_AGENTS=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_EXPERIMENTAL_FEATURES=true
DEBUG_MODE=true
LOG_LEVEL=DEBUG

# Monitoring and Alerting
ALERT_CHANNEL=pre-alerts@nouxcube.app
MONITORING_ENABLED=true
PERFORMANCE_TRACKING=true