# Production Environment Configuration
# Copy this file to .env and update with your actual values

# Domain Configuration
DOMAIN=nouxcube.com
APP_SUBDOMAIN=app
API_SUBDOMAIN=api
WWW_SUBDOMAIN=www

# SSL Configuration
SSL_EMAIL=admin@nouxcube.com
SSL_STAGING=false

# GCP Configuration
GCP_PROJECT_ID=nouxcube-prod
GCP_REGION=europe-west1
GCP_ZONE=europe-west1-b

# Service URLs (auto-generated, do not edit)
FRONTEND_URL=https://${APP_SUBDOMAIN}.${DOMAIN}
API_URL=https://${API_SUBDOMAIN}.${DOMAIN}
MAIN_URL=https://${DOMAIN}
WWW_URL=https://${WWW_SUBDOMAIN}.${DOMAIN}