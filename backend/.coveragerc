# Configuración de cobertura para el backend
# Archivo: backend/.coveragerc

[run]
# Directorio fuente principal (donde está el código de la aplicación)
source = app/

# Archivos y directorios a omitir del análisis de cobertura
omit = 
    # Archivos del sistema y dependencias
    */venv/*
    */env/*
    */.venv/*
    */site-packages/*
    */dist-packages/*
    */usr/local/*
    */usr/lib/*
    
    # Directorios de pruebas (NO incluir tests en cobertura)
    */tests/*
    */test_*
    *test*.py
    
    # Archivos de configuración y setup
    setup.py
    conftest.py
    manage.py
    */migrations/*
    */settings/*
    */config/*
    
    # Archivos auto-generados
    */__pycache__/*
    *.pyc
    *.pyo
    *.pyd
    
    # Archivos específicos del proyecto que no necesitan cobertura
    */main.py
    */core/config.py
    */core/logging.py
    */db/base_class.py
    */db/__init__.py
    */api/__init__.py
    */api/deps.py
    */api/dependencies.py
    
    # Archivos de utilidades que son difíciles de testear
    */utils/exceptions.py
    */utils/logging.py
    
    # Scripts y archivos temporales
    */scripts/*
    */tmp/*
    */temp/*

[report]
# Configuración para el reporte
# Excluir las mismas cosas del reporte
omit = 
    */venv/*
    */env/*
    */.venv/*
    */site-packages/*
    */dist-packages/*
    */usr/local/*
    */usr/lib/*
    */tests/*
    */test_*
    *test*.py
    setup.py
    conftest.py
    manage.py
    */migrations/*
    */settings/*
    */config/*
    */__pycache__/*
    *.pyc
    *.pyo
    *.pyd
    */main.py
    */core/config.py
    */core/logging.py
    */db/base_class.py
    */db/__init__.py
    */api/__init__.py
    */api/deps.py
    */api/dependencies.py
    */utils/exceptions.py
    */utils/logging.py
    */scripts/*
    */tmp/*
    */temp/*

# Mostrar líneas faltantes en el reporte
show_missing = True

# Precisión decimal para porcentajes
precision = 2

# Saltar archivos completamente cubiertos en el reporte resumido
skip_covered = False

# Saltar archivos vacíos
skip_empty = True

# Ordenar por cobertura (ascendente)
sort = Cover

# Excluir líneas que contienen ciertos patrones
exclude_lines =
    # Comentarios pragma para excluir líneas específicas
    pragma: no cover
    
    # No cubrir definiciones abstractas
    def __repr__
    def __str__
    
    # No cubrir código que nunca se ejecuta
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if 0:
    if False:
    
    # No cubrir excepciones que no deberían pasar
    raise AssertionError
    raise NotImplementedError
    raise RuntimeError
    
    # No cubrir imports condicionales
    except ImportError:
    
    # No cubrir logging de debug
    logger.debug
    
    # No cubrir código de desarrollo/debug
    if DEBUG:
    if debug:

[html]
# Configuración para reporte HTML
directory = coverage_report
title = Backend Coverage Report

# Mostrar contextos en el reporte HTML
show_contexts = True

[xml]
# Configuración para reporte XML
output = coverage.xml

[json]
# Configuración para reporte JSON  
output = coverage.json