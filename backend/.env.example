# NouxCubeIA Backend - Environment Variables Template
# Copy this file to .env and update with your values

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# Unified API Key for all microservices (generate with: python scripts/generate_api_key.py)
MICROSERVICES_API_KEY=nxs_dev_YOUR_SECURE_KEY_HERE

# Secret key for session management
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Clerk Authentication
CLERK_API_URL=https://api.clerk.com/v1
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
CLERK_JWT_KEY=your-clerk-jwt-public-key

# =============================================================================
# API CONFIGURATION
# =============================================================================

API_V1_STR=/api/v1
SERVER_NAME=NouxCubeIA API
SERVER_HOST=https://api.example.com

# CORS Configuration
# For development with local network access, add your IPs here (comma-separated)
# Example: http://192.168.1.50:3000,http://192.168.1.50:8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://app.example.com

# Set to true to allow all origins (DEVELOPMENT ONLY - never use in production!)
ALLOW_ALL_CORS=false

# =============================================================================
# DEPLOYMENT MODE (On-Premise vs SaaS)
# =============================================================================

# Single-tenant mode (recommended for on-premise deployments)
# When true: All users belong to a single organization/tenant
# When false: Multi-tenant mode for SaaS deployments (one tenant per org)
SINGLE_TENANT_MODE=true

# Default tenant configuration (used when SINGLE_TENANT_MODE=true)
# The tenant is created automatically on first startup
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_NAME=NouxCubeIA Organization
DEFAULT_TENANT_SLUG=nouxcube

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=nexus_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URLs
DATABASE_URL=postgresql://postgres:password@db:5432/nexus_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/nexus_db

# =============================================================================
# INFRASTRUCTURE SERVICES
# =============================================================================

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# =============================================================================
# MICROSERVICES URLS
# =============================================================================

# Service URLs (internal Docker network)
STORAGE_SERVICE_URL=http://storage-service:8000
CAG_SERVICE_URL=http://weaviate-service:8000
LANGEXTRACT_SERVICE_URL=http://langextract-service:8000
TEXT_EXTRACTION_SERVICE_URL=http://textextract-service:8000
WEAVIATE_SERVICE_URL=http://weaviate-service:8000
ELASTICSEARCH_SERVICE_URL=http://elasticsearch-service:8000
TEMPLATE_EDITOR_SERVICE_URL=http://template-editor-service:8000
GOTENBERG_BASE_URL=http://gotenberg:3000

# Gotenberg Service Configuration
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=600
THUMBNAIL_QUALITY=85
PDF_CONVERSION_TIMEOUT=30
CACHE_ENABLED=true
CACHE_TTL=3600
BACKGROUND_TASKS_URL=http://background-worker:8100
# vLLM (OpenAI-compatible) - primary local LLM server
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen3-4B
VLLM_MAX_MODEL_LEN=16384

# =============================================================================
# ENHANCED OCR CONFIGURATION
# =============================================================================

# Enable enhanced OCR for scanned PDFs (uses EasyOCR + Tesseract fallback)
ENHANCED_OCR_ENABLED=true

# Quality threshold below which enhanced OCR is triggered (0.0 - 1.0)
ENHANCED_OCR_QUALITY_THRESHOLD=0.60

# OCR languages (comma-separated ISO codes: es, en, ca, pt, fr, de)
ENHANCED_OCR_LANGUAGES=es,en

# Use hybrid mode (EasyOCR + Tesseract) for very low quality documents
ENHANCED_OCR_USE_HYBRID=false

# =============================================================================
# IDENTITY DOCUMENT PROCESSING (GDPR-compliant)
# =============================================================================

# Enable identity document extraction (DNI, NIE, Passport, Driver's License)
IDENTITY_DOC_ENABLED=true

# Default retention period in days (GDPR compliance)
IDENTITY_DOC_RETENTION_DAYS=90

# Require explicit consent before processing (recommended: true)
IDENTITY_DOC_REQUIRE_CONSENT=true

# =============================================================================
# GOOGLE CLOUD STORAGE
# =============================================================================

# GCS Configuration
GCS_PROJECT_ID=nexus-document-ia
GCS_BUCKET_NAME=nouxcube-docs-eu
GCS_CREDENTIALS=/app/credentials/nouxcubeia-pre-7d2cb195adc7.json
GCS_REGION=europe-west1
SIGNED_URL_EXPIRATION=3600
MAX_UPLOAD_SIZE=104857600

# =============================================================================
# AI/LLM CONFIGURATION
# =============================================================================

# LLM provider selection: "openai" | "vllm" | "anthropic" | "gemini"
LLM_PROVIDER=vllm

# Models used when running locally via vLLM
LLM_MODEL=${VLLM_MODEL}
DEFAULT_LLM_MODEL=${VLLM_MODEL}

# Embedding Configuration (BGE-M3 - Local Sentence Transformers)
# Model: BAAI/bge-m3 (1024 dim, multilingual, text-only)
# Loaded directly in weaviate-service using sentence-transformers library
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=cuda

# Models used when delegating to OpenAI
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# ANTHROPIC CLAUDE CONFIGURATION (use generic LLM variables)
# =============================================================================
# To use Anthropic Claude, set:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-3-5-haiku-latest  (or claude-3-5-sonnet-latest, claude-3-opus-latest)
#   LLM_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY

# =============================================================================
# SIGNATURE SERVICE CONFIGURATION
# =============================================================================

# Encryption key for signature provider credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SIGNATURE_ENCRYPTION_KEY=your-generated-encryption-key-here

# Webhook secret for signature provider callbacks
SIGNATURE_WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_BASIC_PLAN_ID=price_YOUR_BASIC_PLAN_ID
STRIPE_PREMIUM_PLAN_ID=price_YOUR_PREMIUM_PLAN_ID

# =============================================================================
# EMAIL & NOTIFICATIONS
# =============================================================================

# Email configuration handled by Google Workspace
# No additional email service needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true
TESTING=false
LOG_LEVEL=INFO
# Controls HTTP request logging per microservice (set to false to reduce noise)
REQUEST_LOGGING_ENABLED=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Processing
MAX_DOCUMENT_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv,xlsx
STORAGE_ALLOWED_EXTENSIONS=pdf,doc,docx,txt,md,csv,xlsx,xls,png,jpg,jpeg,gif,bmp,tiff,webp,json,odt

# Agent Configuration
MAX_CONVERSATION_LENGTH=50
DEFAULT_AGENT_TIMEOUT=300

# =============================================================================
# VERIFIED GENERATION (Agent Self-Verifies Pattern)
# =============================================================================
# Stop-and-go verification where each claim is validated against Weaviate
# before being accepted into the final document.
# This reduces hallucinations by ~70% compared to standard generation.

# Maximum number of claims to generate per document
VERIFIED_MAX_CLAIMS=20

# Temperature for claim generation (lower = more deterministic/factual)
VERIFIED_CLAIM_TEMPERATURE=0.3

# Timeout per claim verification in seconds
VERIFIED_TIMEOUT_SECONDS=45

# Minimum confidence threshold to accept a claim (0.0-1.0)
VERIFIED_CONFIDENCE_THRESHOLD=0.7

# Maximum correction attempts per claim position
VERIFIED_MAX_CORRECTION_ATTEMPTS=2

# Automatically accept LLM-suggested corrections
VERIFIED_AUTO_ACCEPT_CORRECTIONS=true

# TTL for verified claims cache in Redis (seconds)
VERIFIED_CACHE_TTL_SECONDS=3600

# Tenant Configuration
MULTI_TENANT=True
DEFAULT_TENANT=default


# =============================================================================
# NOTES
# =============================================================================
# 1. Generate a secure API key: python scripts/generate_api_key.py
# 2. Place GCS credentials in: backend/credentials/nouxcubeia-pre-7d2cb195adc7.json
# 3. Update Clerk keys from: https://dashboard.clerk.com
# 4. Update Stripe keys from: https://dashboard.stripe.com
# 5. For production, use strong passwords and rotate keys regularly
