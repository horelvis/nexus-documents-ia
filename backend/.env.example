# Nexus Document Backend - Environment Variables Template
# Copy this file to .env and update with your values

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# Unified API Key for all microservices (generate with: python scripts/generate_api_key.py)
MICROSERVICES_API_KEY=nxs_dev_YOUR_SECURE_KEY_HERE

# Secret key for session management
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Clerk Authentication
CLERK_API_URL=https://api.clerk.com/v1
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
CLERK_JWT_KEY=your-clerk-jwt-public-key

# =============================================================================
# API CONFIGURATION
# =============================================================================

API_V1_STR=/api/v1
SERVER_NAME=Nexus Document Management API
SERVER_HOST=https://api.example.com
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://app.example.com"]
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=nexus_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URLs
DATABASE_URL=postgresql://postgres:password@db:5432/nexus_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/nexus_db

# =============================================================================
# INFRASTRUCTURE SERVICES
# =============================================================================

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# =============================================================================
# MICROSERVICES URLS
# =============================================================================

# Service URLs (internal Docker network)
STORAGE_SERVICE_URL=http://storage-service:8001
LANGCHAIN_SERVICE_URL=http://langchain-service:8001
LANGGRAPH_SERVICE_URL=http://langgraph-service:8007
LANGROID_SERVICE_URL=http://langroid-service:8002
OLLAMA_BASE_URL=http://ollama-service:11434
GOTENBERG_BASE_URL=http://gotenberg:3000

# =============================================================================
# GOOGLE CLOUD STORAGE
# =============================================================================

# GCS Configuration
GCS_PROJECT_ID=nexus-document-ia
GCS_BUCKET_NAME=nexus-docs-eu
GCS_CREDENTIALS=/app/credentials/nexus-document-ia-04252dae0146.json
SIGNED_URL_EXPIRATION=3600
MAX_UPLOAD_SIZE=104857600

# =============================================================================
# AI/LLM CONFIGURATION
# =============================================================================

# Ollama Models
OLLAMA_MODEL=llama3.2
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
DEFAULT_LLM_MODEL=llama3.2
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Optional: External LLM APIs (if not using Ollama)
# OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
# ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY

# =============================================================================
# SIGNATURE SERVICE CONFIGURATION
# =============================================================================

# Encryption key for signature provider credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SIGNATURE_ENCRYPTION_KEY=your-generated-encryption-key-here

# Webhook secret for signature provider callbacks
SIGNATURE_WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_BASIC_PLAN_ID=price_YOUR_BASIC_PLAN_ID
STRIPE_PREMIUM_PLAN_ID=price_YOUR_PREMIUM_PLAN_ID

# =============================================================================
# EMAIL & NOTIFICATIONS
# =============================================================================

# Email configuration handled by Google Workspace
# No additional email service needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true
TESTING=false
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Processing
MAX_DOCUMENT_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv,xlsx

# Agent Configuration
MAX_CONVERSATION_LENGTH=50
DEFAULT_AGENT_TIMEOUT=300

# Tenant Configuration
MULTI_TENANT=True
DEFAULT_TENANT=default

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Langflow (Visual Agent Builder)
LANGFLOW_DATABASE_URL=sqlite:////app/langflow.db
LANGFLOW_LOG_LEVEL=info
LANGFLOW_OPEN_BROWSER=false
LANGFLOW_REMOVE_API_KEYS=false

# =============================================================================
# NOTES
# =============================================================================
# 1. Generate a secure API key: python scripts/generate_api_key.py
# 2. Place GCS credentials in: backend/credentials/nexus-document-ia-04252dae0146.json
# 3. Update Clerk keys from: https://dashboard.clerk.com
# 4. Update Stripe keys from: https://dashboard.stripe.com
# 5. For production, use strong passwords and rotate keys regularly