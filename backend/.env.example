# API
API_V1_STR=/api/v1
# Generar un token seguro, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_THIS_WITH_A_SECURE_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
SERVER_NAME=Document Management API
SERVER_HOST=https://api.example.com
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://app.example.com"]

# Database  

# PostgreSQL
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=doc_management

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Google Cloud Storage
GCS_BUCKET_NAME=documents
GCS_CREDENTIALS=/app/credentials/gcs-credentials.json
GCS_PROJECT_ID=your-project-id
SIGNED_URL_EXPIRATION=300

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2

# Documentos
MAX_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv,xlsx
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Tenants
MULTI_TENANT=True
DEFAULT_TENANT=default

# Temporary API Key for basic auth (generate a secure random string for actual use)
API_KEY="your_secret_api_key_here_please_change_me"