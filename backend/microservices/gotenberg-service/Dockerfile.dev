FROM python:3.11-slim

# Install system dependencies for PDF processing and Gotenberg
RUN apt-get update && apt-get install -y \
    poppler-utils \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Gotenberg
RUN wget -O /usr/local/bin/gotenberg https://github.com/gotenberg/gotenberg/releases/download/v8.0.3/gotenberg_8.0.3_linux_amd64 \
    && chmod +x /usr/local/bin/gotenberg

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (will be mounted as volume in dev)
COPY app/ ./app/

# Expose port
EXPOSE 8005

# Start script that runs both Gotenberg and the FastAPI app
COPY start-dev.sh /start-dev.sh
RUN chmod +x /start-dev.sh

CMD ["/start-dev.sh"]