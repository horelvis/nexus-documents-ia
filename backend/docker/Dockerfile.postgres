# =============================================================================
# Custom PostgreSQL image with pgvector
# =============================================================================
# Base: apache/age (PG15) — kept as base image for PG15 compatibility.
# Apache AGE extension is no longer used (knowledge graph moved to FalkorDB).
# Added: pgvector (compiled from source — no apt package for PG15)
#
# pgvector is used by:
#   - Few-shot retriever (backend/app/api/v1/prompts.py)
#   - Prompt composer semantic search
#
# TODO: Migrate to plain postgres:15 base once AGE init scripts are removed.
#
# Build: docker compose build db
# =============================================================================

FROM apache/age:release_PG15_1.6.0

# Install build tools, compile pgvector, then clean up
ARG PGVECTOR_VERSION=0.8.0

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        build-essential \
        postgresql-server-dev-15 \
        git \
        ca-certificates && \
    cd /tmp && \
    git clone --branch v${PGVECTOR_VERSION} --depth 1 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make -j$(nproc) OPTFLAGS="-march=native -ftree-vectorize" && \
    make install && \
    cd / && \
    rm -rf /tmp/pgvector && \
    apt-get purge -y build-essential postgresql-server-dev-15 git && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
