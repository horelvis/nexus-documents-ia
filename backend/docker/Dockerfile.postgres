# =============================================================================
# Custom PostgreSQL image — vanilla PG15
# =============================================================================
# Knowledge graph operations use FalkorDB (separate service).
# Vector operations use Weaviate (separate service).
# PostgreSQL stores only relational data: tenants, users, documents, prompts.
#
# Init scripts (run on first startup):
#   - 01-init-langfuse.sql: Creates the Langfuse observability database
#
# Build: docker compose build db
# =============================================================================

FROM postgres:15

COPY init-scripts/ /docker-entrypoint-initdb.d/
