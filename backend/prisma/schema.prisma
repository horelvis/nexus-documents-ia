// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  hashedPassword  String? // Mapped from hashed_password
  fullName        String?   // Mapped from full_name
  isActive        Boolean   @default(true) // Mapped from is_active
  isSuperuser     Boolean   @default(false) // Mapped from is_superuser
  clerkUserId     String?   @unique // Added as per prompt
  createdAt       DateTime  @default(now()) // Mapped from created_at
  updatedAt       DateTime  @updatedAt // Mapped from updated_at

  tenantId        String // Mapped from tenant_id (UUID in SQLAlchemy)
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String?       @unique // Foreign key for one-to-one with Subscription
}

model Tenant {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  // bucket_name String // Specific to app logic, can be added later
  // settings    Json?  // Mapped from JSONB, Prisma uses Json type
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users         User[]
  // documents     Document[] // Document model omitted for now
}

model Subscription {
  id                  String    @id @default(uuid())
  planId              String    // e.g., "free", "pro"
  status              String    // e.g., "active", "canceled", "trialing"
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      // Implicitly creates the one-to-one relation via subscriptionId on User
}
