// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  hashedPassword  String?   // Mapped from hashed_password
  fullName        String?   // Mapped from full_name
  isActive        Boolean   @default(true) // Mapped from is_active
  isSuperuser     Boolean   @default(false) // Mapped from is_superuser
  clerkUserId     String?   @unique // Added as per prompt
  createdAt       DateTime  @default(now()) // Mapped from created_at
  updatedAt       DateTime  @updatedAt

  tenantId        String    // Mapped from tenant_id (UUID in SQLAlchemy)
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  subscription    Subscription? // Back-relation to Subscription

  createdDocuments Document[] @relation("CreatedDocuments") // Documents created by this user
  documentViews    DocumentView[] // Document views by this user
}

model Tenant {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  bucketName    String    // Added from SQLAlchemy model, non-nullable
  settings      Json?     // Added from SQLAlchemy model (JSONB)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users         User[]
  documents     Document[]
  tags          Tag[]
  documentMetrics DocumentMetrics[]
  documentViews DocumentView[]
}

model Document {
  id            String    @id @default(uuid())
  title         String
  description   String?
  filename      String
  filePath      String
  fileType      String
  fileSize      Int
  indexed       Int       @default(0) // See IndexingStatus enum in app.schemas.enums
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  createdById   String
  creator       User      @relation("CreatedDocuments", fields: [createdById], references: [id])

  chunks        DocumentChunk[]
  tags          DocumentTag[] // Join table for many-to-many with Tag
  metrics       DocumentMetrics? // One-to-one with DocumentMetrics
  views         DocumentView[]  // Join table for many-to-many with User (for views)
}

model DocumentChunk {
  id            Int       @id @default(autoincrement())
  chunkIndex    Int
  content       String    @db.Text
  embeddingId   String?   // ID in the vector database

  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex]) // Ensure chunkIndex is unique per document
}

model Tag {
  id            Int       @id @default(autoincrement())
  name          String
  createdAt     DateTime  @default(now())

  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  documents     DocumentTag[] // Join table for many-to-many with Document

  @@unique([tenantId, name]) // Ensure tag name is unique per tenant
}

// Explicit many-to-many join table for Document and Tag
model DocumentTag {
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId         Int
  tag           Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

model DocumentMetrics {
  id            String    @id @default(uuid())
  viewCount     Int       @default(0)
  downloadCount Int       @default(0)
  shareCount    Int       @default(0)
  queryCount    Int       @default(0)
  relevanceScore Float    @default(0.0)
  lastViewedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documentId    String    @unique // One-to-one relation with Document
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  tenantId      String    // For easier querying/filtering by tenant
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
}

// Explicit join table for Document views (User-Document many-to-many with extra fields)
model DocumentView {
  id            String    @id @default(uuid())
  viewedAt      DateTime  @default(now())
  viewDurationSeconds Int?
  isCompleteView Boolean  @default(false)

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  tenantId      String    // For easier querying/filtering by tenant
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([documentId])
  @@index([tenantId])
}

model Subscription {
  id                  String    @id @default(uuid())
  planId              String    // e.g., "free", "pro"
  status              String    // e.g., "active", "canceled", "trialing"
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id]) // Defines the relation and FK
  userId              String    @unique   // The actual foreign key field linking to User.id
}
