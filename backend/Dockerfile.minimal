# Minimal Dockerfile for debugging
FROM python:3.9-slim

WORKDIR /app

# Install FastAPI and requirements
COPY requirements.txt .
RUN pip install fastapi uvicorn
RUN pip install --no-cache-dir -r requirements.txt

# Copy intermediate app
COPY app/main_intermediate.py app/main_intermediate.py

# Expose port
EXPOSE 8000

# Run intermediate app - Cloud Run sets PORT automatically
CMD ["sh", "-c", "python -m uvicorn app.main_intermediate:app --host 0.0.0.0 --port ${PORT:-8000} --log-level info"]