# Minimal Dockerfile for debugging
FROM python:3.9-slim

WORKDIR /app

# Install only FastAPI and uvicorn
RUN pip install fastapi uvicorn

# Copy minimal app
COPY app/main_minimal.py app/main_minimal.py

# Expose port
EXPOSE 8000

# Run minimal app - Cloud Run sets PORT automatically
CMD ["sh", "-c", "python -m uvicorn app.main_minimal:app --host 0.0.0.0 --port ${PORT:-8000} --log-level info"]